<Window x:Class="AerialViews.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        Cursor="None"
        ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="TextShadow" ShadowDepth="2" Direction="315"
                          Color="Black" Opacity="0.7" BlurRadius="4" />
    </Window.Resources>

    <Grid>
        <!-- Fade overlay: animated instead of VideoView.Opacity -->
        <Rectangle x:Name="FadeOverlay" Fill="Black" Opacity="1" IsHitTestVisible="False" />

        <!-- Brightness overlay -->
        <Rectangle x:Name="BrightnessOverlay" Fill="Black" Opacity="0" IsHitTestVisible="False" />

        <!-- Top gradient -->
        <Rectangle x:Name="TopGradient" VerticalAlignment="Top" Height="200" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#AA000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Bottom gradient -->
        <Rectangle x:Name="BottomGradient" VerticalAlignment="Bottom" Height="200" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#AA000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Overlay container -->
        <Grid x:Name="OverlayGrid" Margin="48" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Top-left overlays -->
            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock x:Name="OverlayTopLeft1" FontSize="18" Foreground="White"
                           Effect="{StaticResource TextShadow}" Margin="0,0,0,4" />
                <TextBlock x:Name="OverlayTopLeft2" FontSize="18" Foreground="White"
                           Effect="{StaticResource TextShadow}" />
            </StackPanel>

            <!-- Top-right overlays -->
            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                <TextBlock x:Name="OverlayTopRight1" FontSize="18" Foreground="White"
                           TextAlignment="Right" Effect="{StaticResource TextShadow}" Margin="0,0,0,4" />
                <TextBlock x:Name="OverlayTopRight2" FontSize="18" Foreground="White"
                           TextAlignment="Right" Effect="{StaticResource TextShadow}" />
            </StackPanel>

            <!-- Bottom-left overlays -->
            <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                <TextBlock x:Name="OverlayBottomLeft1" FontSize="18" Foreground="White"
                           Effect="{StaticResource TextShadow}" Margin="0,0,0,4" />
                <TextBlock x:Name="OverlayBottomLeft2" FontSize="18" Foreground="White"
                           Effect="{StaticResource TextShadow}" />
            </StackPanel>

            <!-- Bottom-right overlays -->
            <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <TextBlock x:Name="OverlayBottomRight1" FontSize="18" Foreground="White"
                           TextAlignment="Right" Effect="{StaticResource TextShadow}" Margin="0,0,0,4" />
                <TextBlock x:Name="OverlayBottomRight2" FontSize="18" Foreground="White"
                           TextAlignment="Right" Effect="{StaticResource TextShadow}" />
            </StackPanel>
        </Grid>

        <!-- Progress bar -->
        <ProgressBar x:Name="VideoProgressBar" Height="3" VerticalAlignment="Bottom"
                     Background="#33FFFFFF" Foreground="#AAFFFFFF" Visibility="Collapsed"
                     Minimum="0" Maximum="100" IsHitTestVisible="False" />
    </Grid>
</Window>
