<Window x:Class="AerialViews.UI.ScreensaverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:AerialViews.UI"
        Title="Aerial Views"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        Background="Black"
        Cursor="None"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        MouseDown="Window_MouseDown">

    <Grid x:Name="MainGrid">
        <!-- VideoView moves its content into an owned foreground window above the native video HWND. -->
        <vlc:VideoView x:Name="VideoView" MediaPlayer="{Binding MediaPlayer}" Background="Black">
            <local:VideoOverlay x:Name="Overlay" />
        </vlc:VideoView>
    </Grid>
</Window>
